#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define LWR 1
#define RSE 2
#define ADJ 3

//                &trans  &trans &trans &trans &trans &trans                      &trans  &trans  &trans  &trans &trans  &trans
//                &trans  &trans &trans &trans &trans &trans                      &trans &trans   &trans  &trans &trans  &trans
//                &trans  &trans &trans &trans &trans &trans                      &trans &trans   &trans  &trans &trans  &trans
//                &trans  &trans &trans &trans &trans &trans                      &trans &trans   &trans  &trans &trans  &trans
//                &trans  &trans &trans &trans &trans &trans                      &trans &trans   &trans  &trans &trans  &trans
//                               &trans &trans                                                    &trans  &trans
//                                             &trans &trans  &trans       &trans &trans &trans
//                                                    &trans  &trans       &trans &trans

{
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp ESC         &kp PSCRN   &kp PG_UP   &kp PG_DN   &kp HOME    &kp INS &kp CAPS    &to LWR     &kp C_AL_CALC   &kp C_PP    &kp MINUS   &kp EQUAL
                &kp END         &kp Q       &kp W       &kp E       &kp R       &kp T   &kp Y       &kp U       &kp I           &kp O       &kp P       &kp SLASH
                &kp SCLK        &kp A       &kp S       &kp D       &kp F       &kp G   &kp H       &kp J       &kp K           &kp L       &kp SEMI    &kp SQT
                &kp NUM_LOCK    &kp Z       &kp X       &kp C       &kp V       &kp B   &kp N       &kp M       &kp COMMA       &kp DOT     &kp SLASH   &kp GRAVE
                &kp N1          &kp N2      &kp N3      &kp N4      &kp N5      &kp N6  &kp N7      &kp N8      &kp N9          &kp N0      &kp LBKT    &kp RBKT
                // RC(5,2) RC(5,3)
                &kp UP &kp DOWN
                // RC(5,9) RC(5,8)
                &kp LEFT &kp RIGHT
                // RC(5,4) RC(5,5) RC(6,5)
                &kp RALT &kp SPACE &kp SPACE
                // RC(6,11) RC(5,11) RC(5,10)
                &kp ENTER &kp BACKSPACE &kp DEL
                // RC(5,0) RC(5,1)
                &kp TAB &kp LSHFT
                // RC(5,7) RC(5,6)
                &kp RSHFT &kp RALT'
                >;
        };

        lower_layer {
            bindings = <
                &trans  &trans &trans   &trans    &trans      &trans                                    &to DEFAULT     &to RSE     &trans  &trans &trans  &trans
                &trans  &trans &trans   &trans    &trans      &trans                                    &trans          &trans      &trans  &trans &trans  &trans
                &trans  &trans &trans   &trans    &trans      &trans                                    &F1             &F2         &F3     &F4    &F5     &F6
                &trans  &trans &trans   &trans    &trans      &trans                                    &F7             &F8         &F9     &F10   &F11    &F12
                &trans  &trans &trans   &trans    &trans      &trans                                    &trans          &trans      &trans  &trans &trans  &trans
                               &trans   &trans                                                                                      &trans  &trans
                                                &kp RALT    &kp SPACE   &kp SPACE       &kp BACKSPACE   &kp ENTER       &kp DEL  
                                                            &kp TAB     &kp LSHFT       &kp RSHFT       &kp RALT
            >;
        };

        raise_layer {
            bindings = <
                &trans  &trans &trans &trans    &trans      &trans                                      &to RSE     &to ADJ &trans  &trans &trans  &trans
                &trans  &trans &trans &trans    &trans      &trans                                      &trans      &trans  &trans  &trans &trans  &trans
                &trans  &trans &trans &trans    &trans      &trans                                      &trans      &trans  &trans  &trans &trans  &trans
                &trans  &trans &trans &trans    &trans      &trans                                      &trans      &trans  &trans  &trans &trans  &trans
                &trans  &trans &trans &trans    &trans      &trans                                      &trans      &trans  &trans  &trans &trans  &trans
                               &trans &trans                                                                                &trans  &trans
                                                &kp RALT    &kp SPACE   &kp SPACE       &kp BACKSPACE   &kp ENTER   &kp DEL  
                                                &kp TAB     &kp LSHFT                   &kp RSHFT       &kp RALT
            >;
        };

        adjust_layer {
            bindings = <
                &trans  &bt BT_SEL 0    &out OUT_BLE    &trans  &trans      &trans                                      &trans          &trans      &trans   &trans   &trans    &trans
                &trans  &bt BT_SEL 1    &out OUT_USB    &trans  &trans      &trans                                      &trans          &trans      &trans   &trans   &trans    &trans
                &trans  &bt BT_SEL 2    &trans          &trans  &trans      &trans                                      &trans          &trans      &trans   &trans   &trans    &trans
                &trans  &bt BT_SEL 3    &bt BT_CLR      &trans  &trans      &bootloader                                 &bootloader     &trans      &trans   &trans   &trans    &trans
                &trans  &trans          &trans          &trans  &trans      &trans                                      &trans          &trans      &trans   &trans   &trans    &trans
                                        &trans          &trans                                                                                      &trans   &trans
                                                                &kp RALT    &kp SPACE   &kp SPACE       &kp BACKSPACE   &kp ENTER       &kp DEL  
                                                                &kp TAB     &kp LSHFT                   &kp RSHFT       &kp RALT
            >;
        };
    };
};
